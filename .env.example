# Copy to .env and fill in. .env is git-ignored — never commit it.

# Local PostgreSQL (docker-compose.yml reads these). Choose your own password.
POSTGRES_USER="crm"
POSTGRES_PASSWORD=""
POSTGRES_DB="crm"
DATABASE_URL="postgresql://crm:<POSTGRES_PASSWORD>@localhost:5433/crm"

# 32-byte keys, base64. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing CLIENT_DATA_KEY makes all client personal data unreadable — back it up.
CLIENT_DATA_KEY=""
EMAIL_HASH_KEY=""
